# WSDOT Traveler Information API access code (https://wsdot.wa.gov/traffic/api/)
WSDOT_CODE=
# Windy Webcams API key (https://api.windy.com/keys)
WINDY_API_KEY=
# YouTube Data API v3 key, restricted to that API (https://console.cloud.google.com/apis/credentials)
YOU_TUBE_DATA_API_KEY=
# Optional: GitHub token (Issues: read and write, this repository only) so the Add a camera form can file suggestions
GITHUB_ISSUES_TOKEN=
